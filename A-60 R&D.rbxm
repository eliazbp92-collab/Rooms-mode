-- https://lua.expert/]]></ProtectedString><bool name="Disabled">true</bool><token name="RunContext">2</token><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[ScreenShake]]></string><SharedString name="Tags">MTAwMDAwMDAwMDAwMDAwMA==</SharedString></Properties><Item class="TextBox" referent="18"><Properties><bool name="ClearTextOnFocus">false</bool><Font name="FontFace"><Family><url><![CDATA[rbxasset://fonts/families/Inconsolata.json]]></url></Family><Weight>400</Weight><Style>Normal</Style></Font><bool name="MultiLine">true</bool><Color3 name="PlaceholderColor3"><R>0.699999988079071</R><G>0.699999988079071</G><B>0.699999988079071</B></Color3><bool name="RichText">true</bool><bool name="ShowNativeInput">false</bool><string name="Text"><![CDATA[local Player = game.Players.LocalPlayer
local Character = Player.Character
local MaxDistance = 200
local random = Random.new()
game["Run Service"].RenderStepped:Connect(function()
	if Character then	
		local EntityPosToPlayer = (script.Parent.Position - Character.HumanoidRootPart.Position).Magnitude
		if EntityPosToPlayer < MaxDistance then
            local Speed = 4
		    local mathcos = math.cos(os.clock() * 30)
		    local X = mathcos * Speed / EntityPosToPlayer
		    local Y = mathcos * Speed / EntityPosToPlayer
			local Z = mathcos * Speed / EntityPosToPlayer
			workspace.CurrentCamera.CFrame = workspace.CurrentCamera.CFrame * CFrame.new(random:NextNumber(-X, X),random:NextNumber(-Y, Y),random:NextNumber(-Z, Z)) * CFrame.Angles(random:NextNumber(-X, X),random:NextNumber(-Y, Y),random:NextNumber(-Z, Z))
	    end
    end
end)
]]></string><Color3 name="TextColor3"><R>0</R><G>0</G><B>0</B></Color3><float name="TextSize">14</float><token name="TextXAlignment">0</token><token name="TextYAlignment">0</token><token name="AutomaticSize">3</token><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><Color3 name="BorderColor3"><R>1</R><G>0.6666666865348816</G><B>0</B></Color3><token name="BorderMode">2</token><int name="BorderSizePixel">0</int><int name="LayoutOrder">2</int><UDim2 name="Position"><XS>0</XS><XO>52</XO><YS>0</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>1</YS><YO>0</YO></UDim2><int name="ZIndex">4</int><bool name="AutoLocalize">false</bool><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[SL_CodeTextBox]]></string><SharedString name="Tags">MTAwMDAwMDAwMDAwMDAwMA==</SharedString></Properties><Item class="ObjectValue" referent="19"><Properties><Ref name="Value">18</Ref><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[SaveChangesTo]]></string><SharedString name="Tags">MTAwMDAwMDAwMDAwMDAwMA==</SharedString></Properties></Item><Item class="LocalScript" referent="20"><Properties><ProtectedString name="Source"><![CDATA[-- Saved by UniversalSynSaveInstance (Join to Copy Games) https://discord.gg/wx4ThpAsmw

